# Valores locais de exemplo. Nenhum destes é segredo real.

# --- Aplicação ---
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s
DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable
DATABASE_MAX_CONNS=20

# --- SQS (LocalStack) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
CONSUMER_NAME=wager-transactions-consumer

# --- Autenticação (Keycloak) ---
# AUTH_ISSUER precisa ser idêntico ao claim "iss" dos tokens (URL pública do Keycloak).
AUTH_ISSUER=http://localhost:8080/realms/wager
AUTH_JWKS_URL=http://localhost:8080/realms/wager/protocol/openid-connect/certs
AUTH_AUDIENCE=wager-api
AUTH_PROVIDER_ROLE=provider
AUTH_INTERNAL_ROLE=internal
AUTH_PROVIDER_ID_CLAIM=providerId
AUTH_JWKS_REFRESH=5m

# --- Quais componentes esta instância executa ---
RUN_HTTP=true
RUN_CONSUMER=true
RUN_OUTBOX=true
RUN_RESOLVER=true

# --- Ajustes (opcionais; os valores abaixo são os padrões) ---
CONSUMER_CONCURRENCY=4
CONSUMER_WAIT_TIME=5s
CONSUMER_VISIBILITY_TIMEOUT=30s
CONSUMER_PROCESS_TIMEOUT=20s
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE_DELAY=2s
CONSUMER_RETRY_MAX_DELAY=2m
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
OUTBOX_CONCURRENCY=16
OUTBOX_LEASE=30s
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=1m
PENDING_POLL_INTERVAL=1s
PENDING_BASE_BACKOFF=2s
PENDING_MAX_BACKOFF=2m
PENDING_TTL=15m
PENDING_MAX_ATTEMPTS=12

# --- Rastreamento OpenTelemetry (vazio = desligado) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wager-service

# --- URLs das filas, se injetadas pelo IaC (dispensam sqs:GetQueueUrl) ---
# SQS_WAGER_QUEUE_URL=
# SQS_WAGER_DLQ_URL=
# SQS_EVENTS_QUEUE_URL=

